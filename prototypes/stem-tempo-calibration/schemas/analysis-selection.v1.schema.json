{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opusloops.com/schemas/analysis-selection.v1.schema.json",
  "title": "Opusloops analysis selection approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "approved_at",
    "approved_by",
    "upstream",
    "selection",
    "confirmations"
  ],
  "properties": {
    "schema_version": { "const": "opusloops.analysis-selection.v1" },
    "approval_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "approved_at": { "type": "string", "format": "date-time" },
    "approved_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_manifest_sha256",
        "source_archive_sha256",
        "inventory_sha256"
      ],
      "properties": {
        "run_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "source_archive_sha256": { "$ref": "#/$defs/sha256" },
        "inventory_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_method",
        "assets",
        "full_mix_asset_id",
        "drum_crosscheck_asset_id",
        "sum"
      ],
      "properties": {
        "reference_method": {
          "enum": ["full-mix", "selected-stem-sum"]
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asset_id", "role", "included", "gain_db"],
            "properties": {
              "asset_id": { "$ref": "#/$defs/identifier" },
              "role": {
                "enum": [
                  "full-mix",
                  "drums",
                  "bass",
                  "vocals",
                  "guitar",
                  "keys",
                  "synth",
                  "percussion",
                  "fx",
                  "other"
                ]
              },
              "included": { "type": "boolean" },
              "gain_db": { "type": "number", "minimum": -120, "maximum": 24 }
            }
          }
        },
        "full_mix_asset_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "drum_crosscheck_asset_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "sum": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headroom_db", "normalize_peak_dbfs"],
          "properties": {
            "headroom_db": { "type": "number", "maximum": 0 },
            "normalize_peak_dbfs": { "const": -3 }
          }
        }
      }
    },
    "confirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files_and_hashes_reviewed",
        "roles_reviewed",
        "reference_method_reviewed",
        "originals_unchanged"
      ],
      "properties": {
        "files_and_hashes_reviewed": { "const": true },
        "roles_reviewed": { "const": true },
        "reference_method_reviewed": { "const": true },
        "originals_unchanged": { "const": true }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,199}$"
    }
  }
}
